# CoralStone Properties Listings — environment template
# Copy to `.env.local` and fill in. NEVER commit real secrets. (Masterplan §0, §12)
#
# The current V1 frontend slice runs entirely on mock data and needs NONE of these.
# They are documented here so later stages (Supabase, payments, AI) can slot in.

# ---- Brand / entity ----
NEXT_PUBLIC_SITE_NAME="CoralStone Properties Listings"
NEXT_PUBLIC_DOMAIN=""
SUPPORT_EMAIL=""
WHATSAPP_NUMBER=""

# ---- Supabase (Postgres) — now powers lead storage; run supabase/schema.sql ----
NEXT_PUBLIC_SUPABASE_URL=""     # Project URL (Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # service_role secret — server-only, never expose to the client

# ---- Payments — Stage 7 ----
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# ---- SMS / OTP / USSD (Africa's Talking) — Stage 1 auth, Stage 10 USSD ----
AT_API_KEY=""
AT_USERNAME=""

# ---- Email (Resend) — powers the contact & list-a-property lead forms ----
RESEND_API_KEY=""       # from resend.com/api-keys (starts with "re_")
LEADS_EMAIL=""          # where form submissions are delivered (your inbox)
LEADS_FROM=""           # optional sender; defaults to onboarding@resend.dev.
                        # Until you verify a domain, LEADS_EMAIL must be the
                        # address you signed up to Resend with.

# ---- Maps / geocoding (behind an adapter) ----
MAPS_KEY=""

# ---- AI (Anthropic Claude — server routes only) — Stage 12 ----
ANTHROPIC_API_KEY=""

# ---- Land registry / e-sign (adapter-gated) — Stage 8/9 ----
ARDHISASA_BASE_URL=""
ARDHISASA_API_KEY=""
ESIGN_API_KEY=""
