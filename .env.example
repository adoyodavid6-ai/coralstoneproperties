# CoralStones Properties Listings — environment template
# Copy to `.env.local` and fill in. NEVER commit real secrets. (Masterplan §0, §12)
#
# The current V1 frontend slice runs entirely on mock data and needs NONE of these.
# They are documented here so later stages (Supabase, payments, AI) can slot in.

# ---- Brand / entity ----
NEXT_PUBLIC_SITE_NAME="CoralStones Properties Listings"
NEXT_PUBLIC_DOMAIN=""
SUPPORT_EMAIL=""
WHATSAPP_NUMBER=""

# ---- Canonical site URL (sitemap, robots, OG cards, email links) ----
# Set this in Vercel (Production) to your real domain so absolute URLs aren't
# the *.vercel.app host. If unset, the code falls back to
# VERCEL_PROJECT_PRODUCTION_URL (auto-set by Vercel), then http://localhost:3000.
# e.g. https://coralstonesproperties.co.ke  (no trailing slash)
NEXT_PUBLIC_SITE_URL=""

# ---- Supabase (Postgres) — now powers lead storage; run supabase/schema.sql ----
NEXT_PUBLIC_SUPABASE_URL=""     # Project URL (Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # service_role secret — server-only, never expose to the client

# ---- Admin console (server-side Basic Auth gate on /admin, see src/proxy.ts) ----
ADMIN_USER="admin"             # optional, defaults to "admin"
ADMIN_PASSWORD=""              # REQUIRED in production to open /admin.
                               # Unset → /admin is blocked in prod, open in local dev.

# ---- Payments: Flutterwave (card / mobile money, any currency) ----
# Booking widget stays in demo mode until FLW_SECRET_KEY is set. Test keys from
# dashboard.flutterwave.com start with FLWSECK_TEST-.
FLW_SECRET_KEY=""
NEXT_PUBLIC_FLW_PUBLIC_KEY=""

# ---- Payments: M-Pesa Daraja (STK push to a Till / Buy Goods, KES only) ----
# From developer.safaricom.co.ke → your app. Booking widget's M-Pesa option stays
# in demo mode until KEY + SECRET + PASSKEY + SHORTCODE are all set.
MPESA_ENV="sandbox"                   # "sandbox" | "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""                      # Lipa na M-Pesa Online passkey
MPESA_SHORTCODE=""                    # store/head-office number (used to build the password)
MPESA_TILL=""                         # Buy-Goods Till (PartyB). Leave blank for PayBill mode.
MPESA_TRANSACTION_TYPE="CustomerBuyGoodsOnline"  # or "CustomerPayBillOnline"
# Daraja posts results to ${NEXT_PUBLIC_SITE_URL}/api/mpesa/callback — register
# that exact HTTPS URL on your Daraja app (no query string).

# ---- Payouts: M-Pesa B2C (host disbursements after check-in) ----
# Needs a SEPARATE B2C short code with "Business Payment" enabled, an API
# initiator user, and that user's encrypted SecurityCredential. Host M-Pesa
# payouts stay in demo mode until all three are set. Register the result/timeout
# URLs ${NEXT_PUBLIC_SITE_URL}/api/mpesa/b2c/result and /api/mpesa/b2c/timeout.
MPESA_B2C_SHORTCODE=""
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""           # encrypted initiator password (Daraja cert)

# ---- Payouts: Flutterwave Transfers (host BANK disbursements) + webhook ----
# Bank payouts use FLW_SECRET_KEY above. Set the webhook secret-hash and point a
# FLW webhook at ${NEXT_PUBLIC_SITE_URL}/api/flutterwave/transfer-webhook.
FLW_WEBHOOK_SECRET=""

# ---- Payments: PesaPal (optional, not yet wired) ----
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""

# ---- SMS / OTP / USSD (Africa's Talking) — Stage 1 auth, Stage 10 USSD ----
AT_API_KEY=""
AT_USERNAME=""

# ---- Email (Resend) — powers the contact & list-a-property lead forms ----
RESEND_API_KEY=""       # from resend.com/api-keys (starts with "re_")
LEADS_EMAIL=""          # where form submissions are delivered (your inbox)
LEADS_FROM=""           # optional sender; defaults to onboarding@resend.dev.
                        # Until you verify a domain, LEADS_EMAIL must be the
                        # address you signed up to Resend with.

# ---- Maps / geocoding (behind an adapter) ----
MAPS_KEY=""

# ---- AI (Google Gemini — server routes only) — Stage 12 ----
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# ---- Mediated marketplace (host payouts / escrow) ----
# Encrypts owner payout details (M-Pesa / bank) at rest. Any strong random
# string; generate with:  openssl rand -base64 48
# REQUIRED before hosts can save payout details. Never prefix NEXT_PUBLIC.
PAYOUT_ENC_KEY=""

# ---- Land registry / e-sign (adapter-gated) — Stage 8/9 ----
ARDHISASA_BASE_URL=""
ARDHISASA_API_KEY=""
ESIGN_API_KEY=""
